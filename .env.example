# NASA FIRMS API Configuration
# Obtain your MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# OpenStreetMap / Overpass API Configuration
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Satellite Data / Earth Observation Endpoints
COPERNICUS_API_KEY=your_copernicus_api_key_here

# Project Environment & Path Settings
DEFAULT_CRS=EPSG:4326
DATA_DIR=./data
MODELS_DIR=./models
LOG_LEVEL=INFO
# PostgreSQL / PostGIS Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thermal_intelligence
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
